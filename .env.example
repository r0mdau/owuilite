# Credentials for the owuilite demo stack.
#
#   cp .env.example .env
#
# Docker Compose reads .env from the project directory automatically, and
# `make claude` / `make codex` read LITELLM_MASTER_KEY from it. Variables set
# in your shell take precedence over this file.
#
# WARNING: the values below are well-known defaults for LOCAL DEMOS ONLY.
# compose.yml falls back to the same values when a variable is unset, so the
# stack runs with zero setup. Change every one of them before exposing the
# stack to a network you do not fully trust. Never commit your .env.
#
# Postgres only reads its password when its volume is first initialised:
# after changing a DB password on an existing stack, also change it inside
# Postgres (ALTER USER ... PASSWORD ...) or recreate the volume, which deletes
# its data.

# --- LLM providers (read by LiteLLM via confs/litellm-config.yml) ------------
# Empty by default: models from an unconfigured provider fail on request.
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Second Azure resource, used for gpt-image-1.
AZURE_WESTUS3_OPENAI_API_ENDPOINT=
AZURE_WESTUS3_OPENAI_API_KEY=

# --- LiteLLM ------------------------------------------------------------------
# Master key of the LiteLLM proxy. Open WebUI (chat, RAG embeddings, images),
# the mcpo --api-key and `make claude` / `make codex` all use it.
LITELLM_MASTER_KEY=sk-1234

# --- Open WebUI ---------------------------------------------------------------
# Signs session tokens; shared by both Open WebUI instances.
WEBUI_SECRET_KEY=secret

# --- PostgreSQL ---------------------------------------------------------------
# Used in the DATABASE_URLs and, with otel.compose.yml, by the exporters, so
# keep them URL-safe (no @ : / ? #).
OPENWEBUI_DB_PASSWORD=password
LITELLM_DB_PASSWORD=password

# --- MinIO (S3 storage for Open WebUI uploads) --------------------------------
# Root credentials, also used as Open WebUI's S3 keys and in createbuckets'
# MC_HOST URL, so keep them URL-safe too.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
